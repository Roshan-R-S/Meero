# Backend
PYTHONUNBUFFERED=1
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_COOLDOWN=1.0

# Safety mode
LOCAL_DESKTOP_MODE=true
WEB_SAFE_MODE=true

# Optional API protection
MEERO_API_KEY=change-this-local-key
REQUIRE_API_KEY=false
PROTECT_METRICS=false

# Optional local desktop app allowlist. Empty means all discovered apps are allowed
# when LOCAL_DESKTOP_MODE=true and WEB_SAFE_MODE=false.
APP_LAUNCH_ALLOWLIST=

# Optional LLM
LOCAL_LLM_MODEL_FILE=Llama-3.2-1B-Instruct-Q4_K_M.gguf
LOCAL_LLM_MODEL_PATH=
LLM_API_PROVIDER=
LLM_MODEL_NAME=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Memory
MEMORY_MAX_INTERACTIONS=20
MEMORY_SUMMARY_MAX_CHARS=1200
