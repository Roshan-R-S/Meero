# Backend
PYTHONUNBUFFERED=1
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_COOLDOWN=1.0

# Safety mode
LOCAL_DESKTOP_MODE=true
WEB_SAFE_MODE=true

# Optional API protection
MEERO_API_KEY=change-this-local-key
REQUIRE_API_KEY=false
PROTECT_METRICS=false

# Error detail visibility (set true for development only)
DEBUG_ERRORS=false

# Rate limiter resilience (set false in production to fail closed)
RATE_LIMIT_FAIL_OPEN=true

# Audit logs omit command and response text by default. Enable only for local debugging.
AUDIT_LOG_COMMAND_TEXT=false

# Local desktop app allowlists fail closed when LOCAL_DESKTOP_MODE=true.
# Explicitly list every app that may be launched or closed.
APP_LAUNCH_ALLOWLIST=
APP_CLOSE_ALLOWLIST=
# Force-close only applies to apps that are also present in APP_CLOSE_ALLOWLIST.
APP_FORCE_CLOSE_ALLOWLIST=

# Optional local LLM (GGUF via GPT4All)
LOCAL_LLM_MODEL_FILE=Llama-3.2-1B-Instruct-Q4_K_M.gguf
LOCAL_LLM_MODEL_PATH=

# Memory
MEMORY_MAX_INTERACTIONS=20
MEMORY_SUMMARY_MAX_CHARS=1200

# --- For local desktop assistant mode only (uncomment): ---
# LOCAL_DESKTOP_MODE=true
# WEB_SAFE_MODE=false
# APP_LAUNCH_ALLOWLIST=notepad,calculator,paint,vscode
# APP_CLOSE_ALLOWLIST=notepad,calculator,paint,vscode
# APP_FORCE_CLOSE_ALLOWLIST=notepad
